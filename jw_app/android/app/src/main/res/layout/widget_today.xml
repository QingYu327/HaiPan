<?xml version="1.0" encoding="utf-8"?>
<!--
  今日课表小组件（「仅课表」与「课表 + 考试」共用）。

  布局固定为「头部 / 课表内容区 / 考试区」三段：
  - 课表内容区使用权重占满剩余高度，课程行数变化不会推动考试区；
  - 「还有 N 门」「明天第一门课」固定在内容区底部，不参与顶部排版；
  - 考试区预留固定行数，始终贴底显示。
  字号、内边距由 ScheduleWidgetBase 按桌面实际尺寸设置。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="今日课表"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- 日期与标题同一行，节省头部高度 -->
                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- 正在上课时接管日期位置，由 Chronometer 自动倒计时 -->
                <Chronometer
                    android:id="@+id/chrono_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:fontFamily="sans-serif-medium"
                    android:format="距下课 %s"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_accent"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/courses_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/time1"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/room1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/time2"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/room2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
